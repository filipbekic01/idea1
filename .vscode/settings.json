{
  // Disable other formatters so ESLint owns formatting (Nuxt-recommended setup).
  "prettier.enable": false,
  "editor.formatOnSave": false,

  // Run ESLint --fix on save instead.
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.fixAll.eslint": "explicit"
  },

  // Silence VS Code's built-in stylistic suggestions that overlap with ESLint.
  "javascript.format.enable": false,
  "typescript.format.enable": false,

  // Register ESLint as the default formatter for everything it lints,
  // so the "No formatter installed" warning goes away and ⇧⌥F works.
  "[javascript]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[javascriptreact]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[typescript]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[typescriptreact]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[vue]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[json]": { "editor.defaultFormatter": "vscode.json-language-features" },
  "[jsonc]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[yaml]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[markdown]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },

  // Allow ESLint to act as a formatter (so it shows up in the picker).
  "eslint.format.enable": true,

  // Enable ESLint on every language @nuxt/eslint can lint.
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "yaml"
  ]
}
